["5a6626eed09",{"name":"Be Thou My Vision","origin":"opensong","private":false,"category":"opensong","settings":{"activeLayout":"fa2e8520594","template":"default"},"timestamps":{"created":1793062286043,"modified":null,"used":null},"quickAccess":{"number":"","metadata":{"CCLI":"248328"}},"meta":{"number":"","title":"Be Thou My Vision","author":"Irish Folk Hymn; Elanor H. Hull","copyright":"Public Domain","key":"","CCLI":"248328"},"slides":{"a2e85205948":{"group":"Verse","color":"#5825f5","settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","lines":[{"align":"","text":[{"style":"","value":"Be Thou my Vision, O Lord of my heart,"}],"chords":[{"id":"2e852","pos":0,"key":"D"},{"id":"e8520","pos":11,"key":"Bm7"},{"id":"85205","pos":19,"key":"G"},{"id":"52059","pos":30,"key":"D"}]},{"align":"","text":[{"style":"","value":"Naught be all else to me save that Thou art;"}],"chords":[{"id":"20594","pos":0,"key":"A"},{"id":"05948","pos":14,"key":"Bm7"},{"id":"59483","pos":23,"key":"G"},{"id":"94832","pos":38,"key":"A"}]},{"align":"","text":[{"style":"","value":"Thou my best thought by day or by night,"}],"chords":[{"id":"4832a","pos":0,"key":"Gmaj7"},{"id":"832a4","pos":9,"key":"F#m7"},{"id":"32a48","pos":17,"key":"D"},{"id":"2a489","pos":27,"key":"G"},{"id":"a4890","pos":32,"key":"A"}]},{"align":"","text":[{"style":"","value":"Waking or sleeping, Thy presence my light."}],"chords":[{"id":"4890b","pos":0,"key":"D"},{"id":"890b9","pos":10,"key":"Bm7"},{"id":"90b9b","pos":22,"key":"G2"},{"id":"0b9b5","pos":33,"key":"D"}]}]}],"globalGroup":"verse"},"b9b55e714d7":{"group":"Verse","color":"#5825f5","settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","lines":[{"align":"","text":[{"style":"","value":"Be Thou my wisdom, be Thou my true Word,"}],"chords":[{"id":"9b55e","pos":0,"key":"D"},{"id":"b55e7","pos":11,"key":"Bm7"},{"id":"55e71","pos":20,"key":"G"},{"id":"5e714","pos":33,"key":"D"}]},{"align":"","text":[{"style":"","value":"I ever with Thee and Thou with me, Lord;"}],"chords":[{"id":"e714d","pos":0,"key":"A"},{"id":"714d7","pos":7,"key":"Bm7"},{"id":"14d71","pos":19,"key":"G"},{"id":"4d718","pos":33,"key":"A"}]},{"align":"","text":[{"style":"","value":"Thou my great Father, and I thy true son,"}],"chords":[{"id":"d7183","pos":0,"key":"Gmaj7"},{"id":"7183d","pos":10,"key":"F#m7"},{"id":"183d6","pos":19,"key":"D"},{"id":"83d61","pos":30,"key":"G"},{"id":"3d61c","pos":33,"key":"A"}]},{"align":"","text":[{"style":"","value":"Thou in me dwelling, and I with Thee one."}],"chords":[{"id":"d61c6","pos":0,"key":"D"},{"id":"61c60","pos":11,"key":"Bm7"},{"id":"1c602","pos":23,"key":"G2"},{"id":"c6029","pos":34,"key":"D"}]}]}],"globalGroup":"verse"},"6029f2a835c":{"group":"Verse","color":"#5825f5","settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","lines":[{"align":"","text":[{"style":"","value":"Riches I heed not, nor man's empty praise,"}],"chords":[{"id":"029f2","pos":0,"key":"E"},{"id":"29f2a","pos":9,"key":"C#m7"},{"id":"9f2a8","pos":20,"key":"A"},{"id":"f2a83","pos":32,"key":"E"}]},{"align":"","text":[{"style":"","value":"Thou mine Inheritance now and always;"}],"chords":[{"id":"2a835","pos":0,"key":"B"},{"id":"a835c","pos":12,"key":"C#m7"},{"id":"835c7","pos":19,"key":"A"},{"id":"35c7f","pos":29,"key":"B"}]},{"align":"","text":[{"style":"","value":"Thou and Thou only, first in my heart,"}],"chords":[{"id":"5c7fd","pos":0,"key":"Amaj7"},{"id":"c7fd7","pos":10,"key":"G#m7"},{"id":"7fd79","pos":13,"key":"E"},{"id":"fd798","pos":25,"key":"A"},{"id":"d7986","pos":30,"key":"B"}]},{"align":"","text":[{"style":"","value":"High King of heaven, my Treasure Thou art."}],"chords":[{"id":"79865","pos":0,"key":"E"},{"id":"98654","pos":13,"key":"C#m7"},{"id":"8654b","pos":21,"key":"A2"},{"id":"654bb","pos":34,"key":"E"}]}]}],"globalGroup":"verse"},"54bbf649326":{"group":"Verse","color":"#5825f5","settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","lines":[{"align":"","text":[{"style":"","value":"High King of heaven my victory won,"}],"chords":[{"id":"4bbf6","pos":0,"key":"E"},{"id":"bbf64","pos":13,"key":"C#m7"},{"id":"bf649","pos":20,"key":"A"},{"id":"f6493","pos":28,"key":"E"}]},{"align":"","text":[{"style":"","value":"May I reach heaven's joys, O bright heav'n's Sun;"}],"chords":[{"id":"64932","pos":0,"key":"B"},{"id":"49326","pos":12,"key":"C#m7"},{"id":"9326e","pos":24,"key":"A"},{"id":"326e2","pos":42,"key":"B"}]},{"align":"","text":[{"style":"","value":"Heart of my own heart, whatever befall,"}],"chords":[{"id":"26e22","pos":0,"key":"Amaj7"},{"id":"6e22c","pos":8,"key":"G#m7"},{"id":"e22c6","pos":20,"key":"E"},{"id":"22c6a","pos":27,"key":"A"},{"id":"2c6a5","pos":31,"key":"B"}]},{"align":"","text":[{"style":"","value":"Still be my Vision, O Ruler of all."}],"chords":[{"id":"c6a55","pos":0,"key":"E"},{"id":"6a55a","pos":12,"key":"C#m7"},{"id":"a55a6","pos":19,"key":"A2"},{"id":"55a66","pos":27,"key":"E"}]}]}],"globalGroup":"verse"}},"layouts":{"fa2e8520594":{"name":"Default","notes":"","slides":[{"id":"a2e85205948"},{"id":"b9b55e714d7"},{"id":"6029f2a835c"},{"id":"54bbf649326"}]}},"media":{}}]