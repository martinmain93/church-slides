["58f5ff450a3",{"name":"A Mighty Fortress is Our God","origin":"opensong","private":false,"category":"opensong","settings":{"activeLayout":"a6626eed093","template":"default"},"timestamps":{"created":1793062286045,"modified":null,"used":null},"quickAccess":{"number":""},"meta":{"number":"","title":"A Mighty Fortress is Our God","author":"Martin Luther","copyright":"Public Domain","key":"","CCLI":""},"slides":{"6626eed093a":{"group":"Verse","color":"#5825f5","settings":{},"notes":"","items":[{"style":"top:88px;left:50px;height:904px;width:1820px;","lines":[{"align":"","text":[{"style":"","value":"1A mighty        fortress   is our      God, a        Bulwark   never    failing;"}],"chords":[{"id":"626ee","pos":0,"key":"Bb"},{"id":"26eed","pos":15,"key":"F"},{"id":"6eed0","pos":26,"key":"Eb"},{"id":"eed09","pos":37,"key":"Bb"},{"id":"ed093","pos":50,"key":"Gm"},{"id":"d093a","pos":59,"key":"Bb"},{"id":"093a6","pos":67,"key":"Eb"},{"id":"93a67","pos":69,"key":"F"},{"id":"3a676","pos":71,"key":"Bb"}]},{"align":"","text":[{"style":"","value":"2Did we in       our own    strength confide, our     striving  would be losing;"}],"chords":[]},{"align":"","text":[{"style":"","value":"3And though this world with devils      filled should threaten  to undo   us;"}],"chords":[]},{"align":"","text":[{"style":"","value":"4That Word above all   earthly     pow'r, no     thanks to them abideth;"}],"chords":[]},{"align":"","text":[{"style":"","value":"1Our Helper   He amid the   flood of     mortal   ills prevailing;"}],"chords":[{"id":"a6765","pos":0,"key":"Bb"},{"id":"67652","pos":12,"key":"F"},{"id":"7652c","pos":22,"key":"Eb"},{"id":"652c7","pos":31,"key":"Bb"},{"id":"52c7a","pos":43,"key":"Gm"},{"id":"2c7ad","pos":51,"key":"Bb"},{"id":"c7adb","pos":60,"key":"Eb"},{"id":"7adb0","pos":62,"key":"F"},{"id":"adb0f","pos":67,"key":"Bb"}]},{"align":"","text":[{"style":"","value":"2Were not the right Man on our    side, the    Man of   God's own choosing;"}],"chords":[]},{"align":"","text":[{"style":"","value":"3We will not  fear for  God hath  willed His   truth to triumph   through us:"}],"chords":[]},{"align":"","text":[{"style":"","value":"4The Spirit   and the   gifts are ours through Him who  with us   sideth;"}],"chords":[]},{"align":"","text":[{"style":"","value":"1For still our ancient Foe doth   seek to work us woe;"}],"chords":[{"id":"db0fe","pos":4,"key":"Gm"},{"id":"b0fe4","pos":13,"key":"Csus"},{"id":"0fe4c","pos":15,"key":"C"},{"id":"fe4c5","pos":21,"key":"F"},{"id":"e4c5e","pos":32,"key":"Bb"},{"id":"4c5e5","pos":39,"key":"Eb"},{"id":"c5e50","pos":46,"key":"Gm"}]},{"align":"","text":[{"style":"","value":"2Dost ask who  that may   be: Christ Jesus   it is   He;"}],"chords":[]},{"align":"","text":[{"style":"","value":"3The prince of darkness  grim, we   tremble not for him;"}],"chords":[]},{"align":"","text":[{"style":"","value":"4Let goods and kindred  go, this   mortal  life also;"}],"chords":[]},{"align":"","text":[{"style":"","value":"1His  craft and pow'r are great, and  armed with cruel   hate,"}],"chords":[{"id":"5e508","pos":5,"key":"Gm"},{"id":"e508b","pos":14,"key":"Csus"},{"id":"508b1","pos":17,"key":"C"},{"id":"08b11","pos":21,"key":"F"},{"id":"8b118","pos":33,"key":"Gm"},{"id":"b1184","pos":43,"key":"Cm"},{"id":"1184b","pos":50,"key":"D"}]},{"align":"","text":[{"style":"","value":"2Lord Sabbaoth   His name, from  age to     age the same,"}],"chords":[]},{"align":"","text":[{"style":"","value":"3His  rage we   can   endure for    lo, his    doom is sure,"}],"chords":[]},{"align":"","text":[{"style":"","value":"4The  body      they  may kill; God's truth abideth  still,"}],"chords":[]},{"align":"","text":[{"style":"","value":"1On  earth is not his    equal."}],"chords":[{"id":"184be","pos":4,"key":"Gm"},{"id":"84be5","pos":12,"key":"Bb"},{"id":"4be58","pos":22,"key":"Eb"},{"id":"be58f","pos":24,"key":"F"},{"id":"e58f5","pos":26,"key":"Bb"}]},{"align":"","text":[{"style":"","value":"2And He must  win the    battle."}],"chords":[]},{"align":"","text":[{"style":"","value":"3One little   word shall fell him."}],"chords":[]},{"align":"","text":[{"style":"","value":"4His kingdom  is forever!"}],"chords":[]}]}],"globalGroup":"verse"}},"layouts":{"a6626eed093":{"name":"Default","notes":"","slides":[{"id":"6626eed093a"}]}},"media":{}}]