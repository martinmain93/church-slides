{
  "name": "auto-presenter",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build_relay.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "pnpm sidecar:build && tauri build --config src-tauri/tauri.sidecar.conf.json",
    "codegen": "uv run --project sidecar python shared/codegen.py",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sidecar:build": "uv run --project sidecar python scripts/build_sidecar.py",
    "tauri:build:no-ai": "tauri build",
    "build:relay": "node scripts/build_relay.mjs",
    "relay:dev": "node scripts/build_relay.mjs && wrangler dev --config relay/wrangler.toml"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@fontsource/radley": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "@radix-ui/react-slot": "^1.1.1",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "@tauri-apps/plugin-updater": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "0.8.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "4",
    "qrcode-generator": "1.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wrangler": "4"
  },
  "browserslist": [
    "safari >= 14",
    "ios_saf >= 14",
    "chrome >= 105",
    "and_chr >= 105",
    "firefox >= 115"
  ]
}
