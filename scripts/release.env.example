# Settings for scripts/release.sh, which builds and publishes the official
# release. Copy this file to scripts/release.local.env (git-ignored) and fill
# it in. A fork publishing its own builds sets its own destinations here; a
# build made without these values works fully and sends nothing anywhere.

# GitHub repo whose releases hold the installers and latest.json (public).
RELEASES_REPO=owner/church-slides-releases
# The Netlify site's ID, not its name: `deploy --site <name>` answers Not Found.
NETLIFY_SITE=00000000-0000-0000-0000-000000000000
SITE_URL=https://example.netlify.app
NETLIFY_CLI_VERSION=27
# "-" signs ad hoc. Swap in a "Developer ID Application: ..." identity once
# there is one (notarisation would still need adding to release.sh).
SIGNING_IDENTITY=-
# Signs the in-app updates (minisign, nothing to do with Apple's signing). The
# app only installs an update signed by this key, and its public half is in
# src-tauri/tauri.conf.json. Back it up: lose it and installed copies can never
# update again without a manual reinstall. No password.
UPDATER_KEY="$HOME/.tauri/church-slides-updater.key"

# Baked into the build: error reports (Sentry DSN) and usage statistics (the
# stats Worker in stats/). Leave empty to build without either; the app then
# never asks about them.
CHURCH_SLIDES_SENTRY_DSN=
VITE_CHURCH_SLIDES_STATS_URL=
