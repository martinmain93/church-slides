{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core window/webview/event access for the operator (main) window, the audience projection window and the detached debug window. Custom app commands are not ACL-gated, so only core APIs are listed here.",
  "windows": [
    "main",
    "audience",
    "debug"
  ],
  "permissions": [
    "core:window:allow-available-monitors",
    "core:window:allow-primary-monitor",
    "core:window:allow-current-monitor",
    "core:window:allow-monitor-from-point",
    "core:window:allow-scale-factor",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-focus",
    "core:window:allow-center",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:webview:allow-create-webview-window",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:event:allow-emit-to"
  ]
}
